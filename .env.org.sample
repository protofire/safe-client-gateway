# cgw-org environment. Copy to .env.org (gitignored) and fill in; placeholders only here.
ORG_APPLICATION_PORT=3001
ORG_TRUST_PROXY_HOPS=1
# exact origin: no trailing slash or path
ORG_PUBLIC_APP_URL=https://app.example.com

ORG_DB_HOST=localhost
ORG_DB_PORT=5432
ORG_DB_NAME=org
ORG_DB_APP_USERNAME=org_app
ORG_DB_APP_PASSWORD=change-me
# ORG_DB_MIGRATOR_* (owner login) are read only by the one-off migration entry, not by the runtime

ORG_REDIS_HOST=localhost
ORG_REDIS_PORT=6379/1
# ORG_REDIS_USER=
# ORG_REDIS_PASS=

ORG_AMQP_URL=amqp://localhost:5672
ORG_AMQP_EXCHANGE_NAME=safe-transaction-service-events
ORG_AMQP_QUEUE=cgw-org

# {"current":"v1","keys":{"v1":"<base64 of 32 random bytes>"}}
ORG_ENCRYPTION_KEYS=
# base64 of 32 random bytes
ORG_EMAIL_HASH_KEY=

ORG_OIDC_ISSUER=https://idp.example.com/
ORG_OIDC_CLIENT_ID=change-me
ORG_OIDC_CLIENT_SECRET=change-me
ORG_OIDC_REDIRECT_URI=https://api.example.com/v1/orgs/auth/oidc/callback
ORG_OIDC_POST_LOGIN_REDIRECT=https://app.example.com/

ORG_MAIL_API_KEY=change-me
ORG_MAIL_FROM=noreply@example.com
ORG_MAIL_BASE_URL=https://mail.example.com

ORG_PRICES_PROVIDER_API_KEY=change-me
BLOCKLIST_ENCRYPTED_DATA=change-me
BLOCKLIST_SECRET_KEY=change-me
BLOCKLIST_SECRET_SALT=change-me
